# Database
DATABASE_URL=postgresql://postgres:change-this-local-password@localhost:5432/ai_marketing
POSTGRES_PASSWORD=change-this-local-password

# Redis
REDIS_URL=redis://localhost:6379

# JWT (replace with a random value of at least 32 characters)
JWT_SECRET=replace-this-with-a-long-random-secret-before-use
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Python Worker
PYTHON_WORKER_URL=http://localhost:8000

# Encryption and internal worker authentication
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WORKER_API_KEY=replace-this-with-a-separate-long-random-secret

# Email delivery (required for password recovery and email invitations)
SMTP_URL=
SMTP_FROM=
PUBLIC_APP_URL=http://localhost:5173

# Optional: Default AI Provider
DEFAULT_AI_PROVIDER=openai
DEFAULT_MODEL=gpt-4.1

# Optional server-side provider credentials. Workspace keys can also be set in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
